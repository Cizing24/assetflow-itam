NODE_ENV=production
DEPLOYMENT_ENV=public-demo
DATABASE_URL=postgresql://RUNTIME_ROLE:REPLACE_WITH_SECRET@DB_HOST/assetflow_demo?sslmode=verify-full
APP_ORIGIN=https://REPLACE_WITH_ASSIGNED_HOST
HOST=0.0.0.0
PORT=3001
SESSION_HOURS=1
# One-time provisioner only; use a different migrator DATABASE_URL, never runtime Secrets.
DEMO_DATABASE_HOST=REPLACE_WITH_DB_HOST
DEMO_PROVISION_CONFIRM=CREATE_SYNTHETIC_DEMO
DEMO_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_RANDOM_SECRET_24_CHARS_OR_MORE
DEMO_IT_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_SECRET_24_CHARS_OR_MORE
DEMO_VIEWER_PASSWORD=REPLACE_WITH_PUBLIC_VIEWER_ONLY_PASSWORD_24_CHARS_OR_MORE
# Optional browser build values. This credential is intentionally public and VIEWER only.
VITE_DEMO_VIEWER_PASSWORD=REPLACE_WITH_SAME_VIEWER_ONLY_PASSWORD
